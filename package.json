{
  "name": "autonomous-agent-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "wrangler pages deploy .vercel/output/static",
    "preview": "npx @cloudflare/next-on-pages && wrangler pages dev .vercel/output/static",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test-results/html"
  },
  "dependencies": {
    "next": "^15.3.3",
    "better-auth": "latest",
    "drizzle-orm": "^0.45.2",
    "@neondatabase/serverless": "^0.10.0",
    "googleapis": "^140.0.1",
    "zod": "^3.23.8",
    "tailwindcss": "^3.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "tailwind-merge": "^2.3.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.0.0",
    "geist": "latest"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.11.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.2",
    "prettier": "^3.2.5",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "@cloudflare/next-on-pages": "^1",
    "wrangler": "^3",
    "@playwright/test": "^1.45.0"
  },
  "installCommand": "npm install --legacy-peer-deps"
